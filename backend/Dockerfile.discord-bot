FROM maven:3.9.16-eclipse-temurin-25-noble@sha256:93b8a14ea2f412782e4e842651273b4d903e35cc496284f178fbbe2d67d00976 AS build
WORKDIR /app

COPY backend/pom.xml backend/pom.xml
COPY backend/src backend/src

RUN mvn -f backend/pom.xml -Pdiscord-bot clean package -DskipTests \
    && JDAVE_VERSION="$(mvn -q -f backend/pom.xml help:evaluate -Dexpression=jdave.version -DforceStdout)" \
    && JNA_VERSION="$(mvn -q -f backend/pom.xml help:evaluate -Dexpression=jna.version -DforceStdout)" \
    && OPUS_VERSION="$(mvn -q -f backend/pom.xml help:evaluate -Dexpression=opus-java.version -DforceStdout)" \
    && mkdir -p /app/native \
    && cd /app/native \
    && jar -xf "/root/.m2/repository/club/minnced/jdave-native-linux-x86-64/${JDAVE_VERSION}/jdave-native-linux-x86-64-${JDAVE_VERSION}.jar" \
        natives/linux-x86-64/libdave.so \
    && mv natives/linux-x86-64/libdave.so /app/native/libdave.so \
    && rm -rf /app/native/natives \
    && jar -xf "/root/.m2/repository/club/minnced/opus-java-natives/${OPUS_VERSION}/opus-java-natives-${OPUS_VERSION}.jar" \
        natives/linux-x86-64/libopus.so \
    && mv natives/linux-x86-64/libopus.so /app/native/libopus.so \
    && rm -rf /app/native/natives \
    && jar -xf "/root/.m2/repository/net/java/dev/jna/jna/${JNA_VERSION}/jna-${JNA_VERSION}.jar" \
        com/sun/jna/linux-x86-64/libjnidispatch.so \
    && mv com/sun/jna/linux-x86-64/libjnidispatch.so /app/native/libjnidispatch.so \
    && rm -rf /app/native/com \
    && chmod 0444 /app/native/libdave.so /app/native/libjnidispatch.so /app/native/libopus.so

FROM eclipse-temurin:25.0.4.1_1-jre-noble@sha256:d9a39a23634650173f1e2bbc176227af9728587ecf0f4b62d53e9355cd7a19ab
WORKDIR /app

RUN mkdir -p /var/cache/deefy-discord \
    && chown 1000:1000 /var/cache/deefy-discord \
    && chmod 0750 /var/cache/deefy-discord

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/backend/target/*.jar app.jar
COPY --from=build /app/native/libdave.so native/libdave.so
COPY --from=build /app/native/libjnidispatch.so native/libjnidispatch.so
COPY --from=build /app/native/libopus.so native/libopus.so

ENTRYPOINT ["java", "--enable-native-access=ALL-UNNAMED", "-Djna.boot.library.path=/app/native", "-Djna.nounpack=true", "-Djdave.library.path=/app/native/libdave.so", "-Ddeefy.discord.opus-library-path=/app/native/libopus.so", "-jar", "/app/app.jar"]
