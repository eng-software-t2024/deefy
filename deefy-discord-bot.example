# Non-secret deployment inputs for docker-compose.discord-bot.yml.
# Keep all secret values in protected deployment sources.
DEEFY_DISCORD_BOT_IMAGE_TAG=local
DEEFY_DISCORD_TEST_MODE=false
DEEFY_DISCORD_TEST_GUILD_ID=
DEEFY_API_URL=
DEEFY_SELFHOST_NETWORK=
DEEFY_DISCORD_TOKEN_SOURCE_FILE=
DEEFY_DISCORD_CACHE_VOLUME=deefy-discord-audio-cache

# Playback cache defaults (ISO-8601 durations; do not put credentials here).
DEEFY_DISCORD_PLAYBACK_CACHE_DIRECTORY=/var/cache/deefy-discord
DEEFY_DISCORD_PLAYBACK_CACHE_TTL=PT1H
DEEFY_DISCORD_PLAYBACK_CACHE_MAX_BYTES=1073741824
DEEFY_DISCORD_PLAYBACK_CACHE_MAX_FILE_BYTES=104857600
DEEFY_DISCORD_PLAYBACK_CACHE_CLEANUP_INTERVAL=PT5M
DEEFY_DISCORD_PLAYBACK_AUDIO_INITIAL_BUFFER=PT10S
DEEFY_DISCORD_PLAYBACK_AUDIO_INITIAL_BUFFER_TIMEOUT=PT15S
DEEFY_DISCORD_PLAYBACK_AUDIO_DOWNLOAD_ATTEMPTS=3
DEEFY_DISCORD_PLAYBACK_AUDIO_DOWNLOAD_BACKOFF=PT2S,PT5S,PT10S
DEEFY_DISCORD_PLAYBACK_AUDIO_CONNECT_TIMEOUT=PT10S
DEEFY_DISCORD_PLAYBACK_AUDIO_READ_TIMEOUT=PT20S
DEEFY_DISCORD_PLAYBACK_DECODE_VALIDATION_TIMEOUT=PT20S
DEEFY_DISCORD_PLAYBACK_DECODE_VALIDATION_SAMPLE=PT15S

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
